{
  "expo": {
    "name": "BLUEPRINT",
    "slug": "blueprint-life-os",
    "version": "1.0.0",
    "scheme": "blueprint",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0e0f",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blueprint.lifeos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0e0f"
      },
      "package": "com.blueprint.lifeos"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c8f135"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
